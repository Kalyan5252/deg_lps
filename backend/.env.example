# --- Database ---
# Local Postgres:
DATABASE_URL=postgresql://sqlforge:sqlforge@localhost:5433/sqlforge
#
# Postgres in a Lightning Studio (offloads all SQL to the cloud box). Run
# infra/lightning-studio/setup-postgres.sh in the Studio, open the SSH tunnel
# (infra/lightning-studio/tunnel.sh), then use:
#   DATABASE_URL=postgresql://sqlforge:sqlforge@localhost:5432/sqlforge
#
DB_SSLMODE=disable          # disable (SSH tunnel) | require | verify-full
DB_POOL_MIN=1
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT=15
DB_CONNECT_RETRIES=10

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_TTL_HOURS=720

# --- AI provider (OpenAI-compatible) ---
# Lightning.ai endpoint. Leave LIGHTNING_API_KEY blank to run with the
# built-in rule-based mentor/evaluator (no external calls).
LIGHTNING_API_KEY=
AI_BASE_URL=https://lightning.ai/api/v1
AI_MODEL=lightning-ai/gemma-4-31B-it
AI_TIMEOUT_SECONDS=60

# --- Server ---
CORS_ORIGINS=http://localhost:3000
# Optional regex (matches Vercel preview URLs in production):
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# ==========================================================================
# PRODUCTION (DigitalOcean App Platform) — set these as env vars / secrets in
# the DO dashboard, NOT in this file. See DEPLOY.md.
#   DATABASE_URL=postgresql://doadmin:PASS@db-host:25060/sqlforge   (managed cluster)
#   DB_SSLMODE=require                 # managed Postgres requires TLS
#   DB_POOL_MAX=5                      # stay under the cluster connection limit
#   JWT_SECRET=<long-random-string>
#   CORS_ORIGINS=https://<your-app>.vercel.app
#   CORS_ORIGIN_REGEX=https://.*\.vercel\.app
#   # AI — no local Ollama daemon in prod, so point at Ollama Cloud directly:
#   AI_BASE_URL=https://ollama.com/v1
#   AI_MODEL=gemma4:31b-cloud
#   LIGHTNING_API_KEY=<ollama-cloud-api-key>   # sent as Bearer token
# ==========================================================================
