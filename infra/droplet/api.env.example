# Copy to /etc/deg/api.env on the droplet (chmod 600) and fill in real values.
# This is the app container's environment (docker-compose.prod.yml env_file).

# --- Managed Postgres (DO) ---
DATABASE_URL=postgresql://doadmin:PASSWORD@PRIVATE-DB-HOST:25060/sqlforge?sslmode=require
DB_SSLMODE=require
DB_POOL_MAX=5

# --- Auth ---
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32

# --- CORS (your Vercel frontend) ---
CORS_ORIGINS=https://REPLACE.vercel.app
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# --- AI (Ollama Cloud, OpenAI-compatible; no local daemon on the droplet) ---
AI_BASE_URL=https://ollama.com/v1
AI_MODEL=gemma4:31b-cloud
LIGHTNING_API_KEY=REPLACE_WITH_OLLAMA_CLOUD_KEY
