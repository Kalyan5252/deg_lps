# Copy to /etc/deg/deploy.env on the droplet. Used by the deploy (Caddy needs it).
# nip.io maps <ip>.nip.io -> your droplet IP with no DNS setup. Use DASHES or DOTS:
#   API_DOMAIN=168-144-21-78.nip.io
#   API_DOMAIN=api.yourdomain.com     # if you later point a real domain here
API_DOMAIN=REPLACE-WITH-DROPLET-IP.nip.io
