# Frontend production env (set this in the Vercel dashboard, Project → Settings →
# Environment Variables). The value must be your DEPLOYED backend URL + /api.
#
# After the DigitalOcean backend is live you'll get a URL like
#   https://deg-api-xxxxx.ondigitalocean.app
# so set:
NEXT_PUBLIC_API_BASE=https://deg-api-xxxxx.ondigitalocean.app/api
